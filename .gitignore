.env
.env.*
!.env.example
!docker/.env.example
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.log
/*.pdf
.tmp/
.claude/
.codex_tmp/
logs/
tempdir/
tempdir_ready/
handbook/
# Flow Studio generated runtime artifacts — regenerated at runtime, not tracked
# (same policy as handbook/ and logs/). Hand-authored example DAGs at the dags/
# root (e.g. dags/*.py) stay tracked; only generated project sub-trees are ignored.
/dags/*/
/projects/
/checkpoints/
/backup/
*.rar
# Local debug override file must stay untracked.
/docker/docker-compose.local.debug.yml
# Temporary per-worktree live-test overrides (F1.x) must stay untracked.
/docker/docker-compose.f1-*.override.yml
/.vscode/
# Python packaging artifacts (setuptools copies src/ into build/ during
# `pip wheel .`); they must never enter the OSS repo via `git add -A`.
/build/
/dist/
*.egg-info/
