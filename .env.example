# FFEngine Community environment template
# Copy this file to .env and fill every empty secret before starting Compose.

# Local runtime
TZ=Europe/Istanbul
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5436
AIRFLOW_API_HOST_PORT=8085
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_API_AUTH_JWT_SECRET=
FFENGINE_AIRFLOW_ADMIN_PASSWORD=
FFENGINE_AIRFLOW_BREAKGLASS_PASSWORD=
FFENGINE_AIRFLOW_OP_PASSWORD=
FFENGINE_AIRFLOW_VIEWER_PASSWORD=
AIRFLOW_PARALLELISM=8
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=4
AIRFLOW_MAX_ACTIVE_RUNS_PER_DAG=2
AIRFLOW_DAG_REFRESH_INTERVAL=30
FFENGINE_STUDIO_PROMOTE_VERIFY_TIMEOUT_SECONDS=15

# Local/integration test database environment
# Used by docker/docker-compose.test.yml and integration tests.

# PostgreSQL test container + integration tests
POSTGRES_TEST_USER=ffengine_test
POSTGRES_TEST_PASS=ffengine_pg_pass
POSTGRES_TEST_DB=ffengine_test_db
PG_TEST_HOST=localhost
PG_TEST_PORT=5435

# MSSQL test container + integration tests
MSSQL_SA_PASS=Mssql_password123!
MSSQL_PID=Developer
MSSQL_TEST_HOST=localhost
MSSQL_TEST_PORT=1433
MSSQL_TEST_USER=sa
MSSQL_TEST_PASS=Mssql_password123!
MSSQL_TEST_DB=ffengine_test
MSSQL_TEST_DRIVER={ODBC Driver 17 for SQL Server}

# Oracle test container + integration tests
ORACLE_PASS=Oracle_password123!
ORACLE_TEST_HOST=localhost
ORACLE_TEST_PORT=1521
ORACLE_TEST_USER=ffengine
ORACLE_TEST_PASS=Oracle_password123!
ORACLE_TEST_SERVICE=FREEPDB1
